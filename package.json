{
  "name": "tra-art-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:netlify": "node scripts/netlify-build.mjs",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:security",
    "test:unit": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:auction-load": "node --test tests/load/*.test.mjs",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:database": "node scripts/database-rehearsal.mjs",
    "test:auction-database": "node scripts/auction-database-rehearsal.mjs",
    "test:phase1-database": "node scripts/phase1-database-rehearsal.mjs",
    "test:phase35-database": "node scripts/phase35-database-rehearsal.mjs",
    "test:phase6a-database": "node scripts/phase6a-database-rehearsal.mjs",
    "test:phase6b1-database": "node scripts/phase6b1-migration-rehearsal.mjs",
    "test:development-auth": "node scripts/development-auth-smoke.mjs",
    "cleanup:development-auth": "node scripts/cleanup-development-synthetic-users.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "migration:drift": "node scripts/compare-inventory.mjs",
    "verify": "npm run typecheck && npm test",
    "ci": "npm run verify && npm run build",
    "check:cloudflare": "vinext check && node scripts/cloudflare-build.mjs --validate-only",
    "typecheck:cloudflare": "cf workers types && npm run typecheck",
    "build:cloudflare": "node scripts/cloudflare-build.mjs",
    "preview:cloudflare": "vite preview --host 127.0.0.1 --port 4173",
    "deploy:cloudflare": "node scripts/cloudflare-deploy.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.7",
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@vinext/cloudflare": "^1.3.4",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.14",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.29",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "type": "module"
}
